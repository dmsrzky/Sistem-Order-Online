# ---- Supabase ----
# Project Settings > API di dashboard Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=isi_service_role_key_disini

# ---- Midtrans (SANDBOX) ----
# Dashboard Midtrans > Settings > Access Keys
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxx
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxx
# "true" = produksi, "false" = sandbox. Untuk demo WAJIB false.
# Dua-duanya harus diisi dengan nilai yang SAMA. Yang pertama dipakai server,
# yang kedua dipakai browser untuk memilih skrip Snap yang benar.
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false

# ---- Aplikasi ----
# URL publik setelah deploy, tanpa garis miring di akhir
NEXT_PUBLIC_BASE_URL=https://namaproyek.vercel.app

# ---- Pintu belakang pemicu gagal (HAPUS SEBELUM SERAH TERIMA KE KLIEN) ----
# Kosongkan nilainya untuk mematikan endpoint /api/dev/gagal
DEV_FAIL_TOKEN=ganti-jadi-teks-acak-panjang
